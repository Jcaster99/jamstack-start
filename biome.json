{
	"$schema": "https://biomejs.dev/schemas/2.4.5/schema.json",
	"vcs": {
		"enabled": false,
		"clientKind": "git",
		"useIgnoreFile": false
	},
	"files": {
		"ignoreUnknown": false,
		"includes": [
			"**/src/**/*",
			"*.ts",
			"*.js",
			"**/.vscode/**/*",
			"**/public/admin/index.html",
			"**/packages/create-template/*.js",
			"**/packages/create-template/scripts/**",
			"!**/src/routeTree.gen.ts",
			"!**/src/styles.css",
			"!**/src/locales",
			"!**/packages/create-template/template"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab"
	},
	"assist": {
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	},
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double"
		}
	}
}
